# Para onde o Next encaminha /api e /uploads em dev (API Express)
API_INTERNAL_URL=http://localhost:3333

# ---------- Mapa (opcional) ----------
# Padrão: mapa vetorial OpenFreeMap (gratuito, sem chave), estilo "dark" ajustado à paleta do site.
# Outros estilos do OpenFreeMap: positron, bright, liberty, fiord
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
# Se usar outro provedor, libere o host na CSP:
# NEXT_PUBLIC_MAP_HOSTS=https://tiles.openfreemap.org

# Hosts extras de imagem (ex.: bucket R2 público), separados por espaço
# NEXT_PUBLIC_IMAGE_HOSTS=https://pub-xxxx.r2.dev
